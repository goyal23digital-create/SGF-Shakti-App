generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Master Data ──────────────────────────────────────────────────────────────

model Item {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique
  name                  String
  avgHourlyProduction   Decimal? @db.Decimal(10, 2)
  maxHourlyProduction   Decimal? @db.Decimal(10, 2)
  avgWeight             Decimal? @db.Decimal(10, 3)
  withFlashWeight       Decimal? @db.Decimal(10, 3)
  maxWeight             Decimal? @db.Decimal(10, 3)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  partyRates    PartyItemRate[]
  inventoryIns  InventoryIn[]
  sales         Sale[]
  salesReturns  SaleReturn[]

  @@map("items")
}

model Party {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  city      String?
  phone     String?
  gstin     String?
  address   String?
  stateCode String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates        PartyItemRate[]
  sales        Sale[]
  salesReturns SaleReturn[]
  payments     PartyPayment[]

  @@map("parties")
}

model PartyItemRate {
  id        Int      @id @default(autoincrement())
  partyId   Int
  itemId    Int
  rate      Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id])
  item  Item  @relation(fields: [itemId], references: [id])

  @@unique([partyId, itemId])
  @@map("party_item_rates")
}

// ── Transaction Ledgers ───────────────────────────────────────────────────────

enum InventoryInType {
  OPENING
  PRODUCTION
  ADJUSTMENT
}

model InventoryIn {
  id        Int             @id @default(autoincrement())
  date      DateTime        @db.Date
  itemId    Int
  quantity  Decimal         @db.Decimal(12, 3)
  type      InventoryInType @default(PRODUCTION)
  remarks   String?
  fyYear    String          // e.g. "2026-27"
  isVoided  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  createdBy Int?

  item      Item  @relation(fields: [itemId], references: [id])
  creator   User? @relation("InventoryInCreator", fields: [createdBy], references: [id])

  @@index([date])
  @@index([itemId])
  @@index([fyYear])
  @@map("inventory_in")
}

model Sale {
  id             Int      @id @default(autoincrement())
  date           DateTime @db.Date
  itemId         Int
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  carriageAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxPercent     Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  gstType        String   @default("IGST")
  partyId        Int
  remarks        String?
  fyYear         String
  isVoided       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  Int?

  item      Item  @relation(fields: [itemId], references: [id])
  party     Party @relation(fields: [partyId], references: [id])
  creator   User? @relation("SaleCreator", fields: [createdBy], references: [id])

  @@index([date])
  @@index([partyId])
  @@index([itemId])
  @@index([fyYear])
  @@map("sales")
}

model SaleReturn {
  id             Int      @id @default(autoincrement())
  date           DateTime @db.Date
  itemId         Int
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  carriageAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxPercent     Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  gstType        String   @default("IGST")
  partyId        Int
  remarks        String?
  fyYear         String
  isVoided       Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?

  item      Item  @relation(fields: [itemId], references: [id])
  party     Party @relation(fields: [partyId], references: [id])
  creator   User? @relation("SaleReturnCreator", fields: [createdBy], references: [id])

  @@index([date])
  @@index([partyId])
  @@index([fyYear])
  @@map("sale_returns")
}

enum PaymentMode {
  BF
  BANK
  CASH
  TRANSPORT
  OTHER
}

model PartyPayment {
  id          Int         @id @default(autoincrement())
  date        DateTime    @db.Date
  partyId     Int
  amount      Decimal     @db.Decimal(14, 2)
  paymentMode PaymentMode @default(CASH)
  remarks     String?
  fyYear      String
  isVoided    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdBy   Int?

  party     Party @relation(fields: [partyId], references: [id])
  creator   User? @relation("PaymentCreator", fields: [createdBy], references: [id])

  @@index([date])
  @@index([partyId])
  @@index([fyYear])
  @@map("party_payments")
}

model ExpenseCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id         Int         @id @default(autoincrement())
  date       DateTime    @db.Date
  payee      String
  categoryId Int?
  amount     Decimal     @db.Decimal(14, 2)
  paymentMode PaymentMode @default(CASH)
  remarks    String?
  fyYear     String
  isVoided   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  createdBy  Int?

  category  ExpenseCategory? @relation(fields: [categoryId], references: [id])
  creator   User?            @relation("ExpenseCreator", fields: [createdBy], references: [id])

  @@index([date])
  @@index([fyYear])
  @@map("expenses")
}

// ── Settings ──────────────────────────────────────────────────────────────────

model CompanySettings {
  id                Int      @id @default(1)
  companyName       String   @default("Shakti Gold Furniture")
  tagline           String?
  logoDataUri       String?  @db.Text
  gstin             String?
  stateCode         String?
  address           String?
  phone             String?
  email             String?
  defaultTaxPercent Decimal  @default(18) @db.Decimal(5, 2)
  defaultGstType    String   @default("IGST")
  accentColor       String   @default("#4f46e5")
  lowStockThreshold Int      @default(10)
  invoicePrefix     String   @default("SGF")
  updatedAt         DateTime @updatedAt

  @@map("company_settings")
}

// ── Auth & Audit ──────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryInsCreated   InventoryIn[]  @relation("InventoryInCreator")
  salesCreated          Sale[]         @relation("SaleCreator")
  saleReturnsCreated    SaleReturn[]   @relation("SaleReturnCreator")
  paymentsCreated       PartyPayment[] @relation("PaymentCreator")
  expensesCreated       Expense[]      @relation("ExpenseCreator")
  auditLogs             AuditLog[]

  @@map("users")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String   // CREATE | UPDATE | VOID
  tableName String
  recordId  Int
  oldValues Json?
  newValues Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([tableName, recordId])
  @@index([userId])
  @@map("audit_logs")
}
